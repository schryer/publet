/target
.venv/
__pycache__/
.pytest_cache/
*.pyc
/tests/.uv-cache
.matrix-cache/
*.redb

# Generated by `curvenote build --typst` from index.md/myst.yml, under
# <doc>/<variant>/ - never hand-edit these. Unanchored (no leading slash)
# because a <doc> can itself sit under a group directory (publets/<name>/
# as well as spec/), putting the output at varying depths.
main.typ
main.pdf
main.bib
lapreprint.typ
frontmatter.typ
LICENSE
myst-imports.typ
_build/
render-record.json
render.json
# A corpus's working store and secret key; objects/ is its durable form.
/corpus/.publet/
# `pub render` output; the publet's source is publet.json beside it.
/corpus/publets/*/index.md
/corpus/publets/*/myst.yml

*.pdf
!*/*/versions/*.pdf

# The rules above are aimed at <doc>/<variant>/ output and would also
# catch same-named files in the shared template library - never ignore
# anything there, it's all real, committed source (either a genuine
# upstream jtex template, or our own thin wrapper around a Typst
# Universe package).
!/templates/**
