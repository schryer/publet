/target
.venv/
__pycache__/
.pytest_cache/
*.pyc
/tests/.uv-cache
.matrix-cache/

# Generated by `curvenote build --typst` from index.md/myst.yml, under
# <doc>/<variant>/ - never hand-edit these; two levels below repo root.
/*/*/main.typ
/*/*/main.pdf
/*/*/main.bib
/*/*/lapreprint.typ
/*/*/frontmatter.typ
/*/*/LICENSE
/*/*/myst-imports.typ
/*/_build/

*.pdf
!*/*/versions/*.pdf

# The rules above are aimed at <doc>/<variant>/ output and would also
# catch same-named files in the shared template library - never ignore
# anything there, it's all real, committed source (either a genuine
# upstream jtex template, or our own thin wrapper around a Typst
# Universe package).
!/templates/**
